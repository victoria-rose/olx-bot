OPENROUTER_API_KEY=
# Any chat model on OpenRouter, e.g. google/gemma-3-27b-it, anthropic/claude-sonnet-4, x-ai/grok-4.1-fast
OPENROUTER_MODEL=
# xchat auth: x-access-token request header == `_bifro_jwt` cookie on any
# https://xchat.olx.in/* request (devtools -> copy while logged in to OLX chat).
# Short-lived (~hours); on 401/403 re-export and restart.
XCHAT_TOKEN=
# XMPP password: the `ct`-cookie chatToken (devtools -> copy, ~24h life).
CHAT_TOKEN=
# Your OLX country domain, e.g. https://www.olx.in https://www.olx.pl https://www.olx.ua
OLX_BASE_URL=https://www.olx.in
# Ad id = digits in the listing URL.
AD_ID=
# What you're selling — any category works.
ITEM_CATEGORY=used phone
LISTING_TITLE=
LISTING_URL=
ASKING_PRICE=
FLOOR_PRICE=
CURRENCY=INR
CONDITION=
LOCATION=
# Free-form details the LLM answers buyer questions from
# (specs, accessories, bill/warranty, pickup/meetup area, anything relevant).
ITEM_DETAILS=
# Buyer languages to match, e.g. "English, Hindi" or "Polish" or "Ukrainian".
LANGUAGE_HINT=the buyer's language
# 1 = print replies instead of sending (start here). 0 = actually send.
DRY_RUN=1
POLL_SECONDS=60
